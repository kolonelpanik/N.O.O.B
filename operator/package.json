{
  "name": "noob-operator",
  "private": true,
  "version": "0.2.0",
  "description": "N.O.O.B. Never Out of Bounds hardware console operator",
  "author": "N.O.O.B. Project",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 dist-electron/electron/main.js && cross-env NOOB_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run clean && tsc -b && vite build && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "start": "electron .",
    "icon:mac": "bash scripts/generate-macos-icon.sh",
    "package:mac": "npm run build && npm run icon:mac && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --publish never",
    "dist:mac": "npm run build && npm run icon:mac && electron-builder --mac dmg zip --publish never",
    "verify:mac": "bash scripts/verify-macos-bundle.sh"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.neveroutofbounds.noob-operator",
    "productName": "N.O.O.B",
    "artifactName": "NOOB-Operator-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "electronLanguages": [
      "en"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/noob.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "N.O.O.B. discovers authorized local console appliances before opening a pinned SSH tunnel.",
        "NSBonjourServices": [
          "_noob-kvm._tcp"
        ]
      }
    },
    "dmg": {
      "title": "N.O.O.B. Operator ${version}",
      "sign": false
    }
  }
}
