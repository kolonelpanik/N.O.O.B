# Managed by N.O.O.B. USB recovery installer. Do not edit in place.
[Match]
Name=__NOOB_USB_INTERFACE__

[Link]
# A missing recovery cable must never delay the appliance boot.
RequiredForOnline=no

[Network]
Description=N.O.O.B. independent USB recovery path
DHCP=ipv4
IPv6AcceptRA=yes
LinkLocalAddressing=ipv6
LLMNR=no
DNSDefaultRoute=no

[DHCPv4]
# usb0 is the preferred same-LAN return path while its carrier exists, but it
# must not replace the operator's DNS, NTP, domain, or hostname configuration.
RouteMetric=100
UseDNS=no
UseNTP=no
UseDomains=no
SendHostname=no

[IPv6AcceptRA]
RouteMetric=100
UseDNS=no
UseDomains=no
