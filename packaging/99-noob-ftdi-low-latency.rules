# Keep the verified FT232H UART bridge responsive enough for interactive HID.
# This board has no EEPROM serial, so match its exact FTDI product identity.
ACTION=="add", SUBSYSTEM=="usb-serial", KERNEL=="ttyUSB[0-9]*", DRIVER=="ftdi_sio", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6014", ATTRS{manufacturer}=="FTDI", ATTRS{product}=="Single RS232-HS", ATTR{latency_timer}="1"
