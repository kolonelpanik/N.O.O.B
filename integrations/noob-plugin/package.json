{
  "name": "noob-mcp-server",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first MCP Apps control plane for N.O.O.B. hardware KVM appliances",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "noob-mcp-server": "dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:widget": "cross-env INPUT=widget/operator-console.html vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run clean && npm run build:widget && npm run build:server",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepare:local": "node scripts/prepare-local-plugin.mjs",
    "start": "node dist/main.js --stdio",
    "start:http": "node dist/main.js --http"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "bonjour-service": "1.3.0",
    "express": "5.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "cross-env": "10.1.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.11"
  }
}
